ORS_API_KEY=your-openrouteservice-api-key

# User-Agent inviato a Nominatim/Photon (le policy OSM richiedono un contatto reale)
NOMINATIM_USER_AGENT=stageMatch/1.0 (contatto@tuodominio.it)

# Google OAuth Credentials (usate per il login di studenti e aziende)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Secret Flask per firmare i cookie di sessione (obbligatorio: l'app non parte senza)
SERVER_SECRET_KEY=altra-stringa-segreta-e-lunga

# Email di supporto mostrata in Impostazioni, informativa e termini (opzionale)
SUPPORT_EMAIL=

# Email Google (separate da virgola) degli amministratori che possono generare
# i codici di accesso monouso delle aziende da /admin/codes
ADMIN_EMAILS=admin@tuodominio.it

# Rate limiting
# Max sessioni simultanee per lo stesso utente
MAX_SESSIONS_PER_USER=3
# Max sessioni attive totali nell'applicazione
MAX_SESSIONS_GLOBAL=100
# Durata (secondi) prima che una sessione inattiva sia considerata scaduta
SESSION_TTL_SECONDS=28800

# Stringa di connessione al database (in Docker Compose è già impostata dal compose)
DB_CONNECTION_STRING=database.db

# Indirizzo e porte dei due servizi
HOST=127.0.0.1
PORT=5000
PORT_API=5001
# URL del geo-proxy (server.py) usato da app.py e dal motore di matching
API_URL=http://127.0.0.1:5001

# Debug (mai True in production: espone il debugger interattivo di Werkzeug)
DEBUG=False
# Livello di log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Log delle query SQL (contengono dati personali: solo per sviluppo)
SQL_ECHO=False

# Versione dell'informativa privacy: cambiarla richiede un nuovo consenso in registrazione
PRIVACY_POLICY_VERSION=2026-09-20

# Versione applicativa mostrata in Impostazioni > Informazioni
APP_VERSION=1.0.0

# Matching AI (rifinitura del punteggio deterministico studente/annuncio, dati anonimizzati)
ANTHROPIC_MATCHING_ENABLED=True
# Provider da usare per la rifinitura: "anthropic" (default) oppure "deepseek"
MATCH_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
# Punteggio minimo (0-100) sopra cui un nuovo match genera una notifica allo studente
MATCH_NOTIFY_MIN_SCORE=70
