ORS_API_KEY=your-openrouteservice-api-key

# Google OAuth Credentials (usate per il login di studenti e aziende)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Secret Flask per firmare i cookie di sessione
SERVER_SECRET_KEY=altra-stringa-segreta-e-lunga

# Rate limiting
MAX_SESSIONS_PER_USER=1       # Max sessioni simultanee per lo stesso utente
MAX_SESSIONS_GLOBAL=100       # Max sessioni attive totali nell'applicazione
SESSION_TTL_SECONDS=28800     # Durata (secondi) prima che una sessione inattiva sia considerata scaduta

# Stringa di connessione al database
DB_CONNECTION_STRING=users.db

# Porta dell'applicazione
PORT=5000

# Debug (mai True in production)
DEBUG=True

PRIVACY_POLICY_VERSION=2026-04-21
